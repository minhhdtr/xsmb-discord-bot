# Bot token from https://discord.com/developers/applications
# The application must have the MESSAGE CONTENT INTENT switched on, otherwise
# message bodies arrive empty and no command is ever seen.
DISCORD_TOKEN=

# Register slash commands to one server, where they appear immediately.
# Leave empty to register globally, which can take up to an hour to spread.
DISCORD_GUILD_ID=

# Keep the !xsmb form working alongside slash commands. Turning this off also
# drops the Message Content intent, so the app needs no privileged intent.
PREFIX_COMMANDS=true

# Command prefix. No spaces. Only used when PREFIX_COMMANDS is on.
COMMAND_PREFIX=!xsmb

# debug | info | warn | error
LOG_LEVEL=info

# Used by docker compose to build DATABASE_URL. Change the password.
POSTGRES_USER=xsmb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xsmb

# Only needed when running the binary outside compose.
# DATABASE_URL=postgres://xsmb:change-me@localhost:5432/xsmb?sslmode=disable

# Override the source site. Leave empty for https://xoso.com.vn
# XOSO_BASE_URL=

# --- Backfill ---------------------------------------------------------------
# On startup the bot fills the archive in the background. It never blocks
# commands, walks newest-first, skips days it already has, and stops at once
# if the source starts refusing requests.
BACKFILL_ON_START=true

# How far back to reach, in days. 0 means the whole archive, back to
# 01/10/2005 - roughly 7,600 days. That is the default.
BACKFILL_DAYS=0

# Days fetched at once.
BACKFILL_CONCURRENCY=8

# Minimum gap between requests. 0 means no pacing.
BACKFILL_RATE=0

# Explicit start date; overrides BACKFILL_DAYS when set.
# BACKFILL_FROM=01/10/2005

# --- Giá vàng ---------------------------------------------------------------
# Lệnh !gold. Để rỗng thì tắt hẳn tính năng này.
GOLD_PREFIX=!gold

# Nguồn giá vàng. Không cần API key.
GOLD_URL=https://www.vang.today/api/prices

# Giữ bảng giá bao lâu trước khi hỏi lại nguồn.
GOLD_TTL=2m

# Khi nguồn hỏng, được phép trả bảng cũ trong bao lâu. Quá mốc này thì báo lỗi
# thật thay vì giả vờ giá cũ là giá hiện tại.
GOLD_GRACE=30m
